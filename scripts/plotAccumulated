#! /usr/bin/env python3
"""Accumulated slip profiles across earthquake cycles, in one figure.

Walks the selected cycles in order, extracts the slip profile from every
fault.NNNNN.nc snapshot (mode 1: vertical at mid-strike; mode 2: horizontal at
3/4 of the model depth), offsets each cycle by the final slip of the previous
one, and draws them all on one axes -- the classic stacked-slip-history plot.
Lines are boxcar-smoothed over --nwindow nodes; every --ninterval-th snapshot
is drawn.

Multi-fault runs: --fault selects the fault whose plane is profiled
(default 0).

Reads:  fault.NNNNN.nc from every selected cycle
Writes: accumulatedSlip.{vertical,horizontal}.png into the case directory
        (cwd for a flat run)
"""

import glob
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import plotutils as pu
from lib import boxcar_average

pu.apply_style()
import matplotlib.pyplot as plt
import numpy as np
import netCDF4 as nc

PATTERNS = ["fault.[0-9]*.nc"]


def cycle_profiles(rdir, mode, ninterval, nwindow, ifault):
    snaps = pu.sort_nicely(
        [f for f in glob.glob(os.path.join(rdir, "fault.*.nc"))
         if pu.step_of(f) is not None])[::ninterval]
    cols = []
    for f in snaps:
        with nc.Dataset(f) as d:
            v = np.asarray(pu.fault_slab(d.variables["slips"][:], ifault,
                                         "slips", f), float)
        line = v[:, v.shape[1] // 2] if mode == 1 else v[(v.shape[0] // 4) * 3, :]
        shape = v.shape
        cols.append(boxcar_average(line, min(nwindow, len(line))))
    return np.array(cols).T, shape


def main():
    ap = pu.make_parser(__doc__, "plotAccumulated",
                        "accumulatedSlip.{vertical,horizontal}.png, all cycles stacked in "
                        "one figure.", PATTERNS)
    ap.add_argument("--mode", type=int, choices=[1, 2], default=2,
                    help="1: vertical profile at mid-strike; "
                         "2: horizontal profile at 3/4 depth (default)")
    ap.add_argument("--fault", type=int, default=0,
                    help="fault index for multi-fault runs (default 0)")
    ap.add_argument("--ninterval", type=int, default=1,
                    help="draw every Nth snapshot (default 1: all)")
    ap.add_argument("--nwindow", type=int, default=10,
                    help="boxcar smoothing window in nodes (default 10)")
    args = ap.parse_args()

    targets = pu.resolve_targets(args.dirs, PATTERNS, "plotAccumulated")
    data = None
    for label, rdir in targets:
        print(f"processing {label or rdir} ({rdir})")
        tmp, profile_shape = cycle_profiles(rdir, args.mode, args.ninterval,
                                            args.nwindow, args.fault)
        data = tmp if data is None else np.concatenate(
            (data, tmp + data[:, -1, np.newaxis]), axis=1)

    # Physical axis, not node numbers. boxcar_average is a valid-mode
    # convolution, so a 26-node profile smoothed over 10 comes back with 17
    # points; the coordinates have to be trimmed to match, symmetrically,
    # because each smoothed value sits at the centre of its window. Getting
    # this wrong is why the axis read "node #" and a step-over plot could not
    # be told where along strike anything happened.
    par = pu.load_par(targets[0][1])
    ndip, nstrike = profile_shape
    orient = "Vertical" if args.mode == 1 else "Horizontal"
    xaxis, xlabel = None, ("node # down dip" if args.mode == 1
                           else "node # along strike")
    if par is not None:
        xkm, zkm, strike_lab, dip_lab = pu.fault_coords(par, ndip, nstrike,
                                                        args.fault)
        full = zkm if args.mode == 1 else xkm
        cut = len(full) - data.shape[0]
        if cut >= 0:
            lo = cut // 2
            xaxis = full[lo:lo + data.shape[0]]
            xlabel = dip_lab if args.mode == 1 else strike_lab

    fig, ax = plt.subplots(figsize=(8, 6))
    for i in range(data.shape[1]):
        if xaxis is None:
            ax.plot(data[:, i], color="black", lw=0.7)
        else:
            ax.plot(xaxis, data[:, i], color="black", lw=0.7)
    ax.set_xlabel(xlabel)
    ax.set_ylabel("accumulated slip (m)")
    ax.set_title(f"Accumulated slip — {orient.lower()} profile — "
                 f"{len(targets)} cycle(s), {data.shape[1]} snapshots"
                 + (f" — fault {args.fault}" if args.fault else ""))
    ax.grid(alpha=0.3)
    fig.tight_layout()

    name = f"accumulatedSlip.{orient.lower()}.png"
    if args.outdir:
        os.makedirs(args.outdir, exist_ok=True)
        out = os.path.join(args.outdir, name)
    elif len(targets) == 1:
        out = os.path.join(targets[0][1], name)
    else:
        out = name
    pu.save(fig, out, dpi=150)
    return 0


if __name__ == "__main__":
    sys.exit(main())
