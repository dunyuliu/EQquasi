#! /usr/bin/env python3
"""Map every on-fault variable of each fault.NNNNN.nc snapshot, plus a gif.

For each snapshot this draws a 3x3 sheet: shear stresses (strike, dip),
effective normal stress, log10 slip rate, normal-regularised state, log10
state, and the peak-slip-rate history (linear, log10, and against simulated
time) with the current step marked. Stresses are shown in MPa on a diverging
map centred on the case's initial values (from user_defined_params.py, found
in the results directory or its parent).

Multi-fault runs (ntotft > 1): one PNG per fault per snapshot, suffixed .f0,
.f1, ..., and one gif per fault -- no fault is silently dropped. Legacy 2-D
snapshots (pre-nid_fault) are read transparently.

The gif's cadence is the run's nt_out: nt_out = 1000 gives a handful of coarse
frames. Each frame carries its step number and simulated time; a smooth movie
needs a smaller nt_out at run time, not interpolation here.

Reads:  fault.NNNNN.nc, global.dat, user_defined_params.py (dir or parent)
Writes: fault.NNNNN.nc[.fN].png and on_fault_vars[.fN].gif per cycle
"""

import glob
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import plotutils as pu
from seasio import read_array

pu.apply_style()
import matplotlib.pyplot as plt
import numpy as np
import netCDF4 as nc

PATTERNS = ["fault.[0-9]*.nc", "global.dat"]

STRESS_R = 10.0   # half-range around the reference stress, MPa


def peak_slip_rate(b, par):
    """(linear, log10) peak slip rate. bp == 8 writes log10(Vmax) in column 2,
    as that benchmark asks; every other bp writes it linearly."""
    if getattr(par, "bp", 0) == 8:
        return 10.0 ** b[:, 1], b[:, 1]
    return b[:, 1], np.log10(np.maximum(b[:, 1], 1e-300))


def plot_fault_snapshot(fname, ift, nfault, par, b, png):
    ds = nc.Dataset(fname)
    v = {name: pu.fault_slab(ds.variables[name][:], ift, name, fname)
         for name in ("shear_strike", "shear_dip", "effective_normal",
                      "slip_rate", "state_variable", "state_normal")}
    ds.close()

    ndip, nstrike = v["shear_strike"].shape
    x, z, xlab, ylab = pu.fault_coords(par, ndip, nstrike)
    mn = par.init_norm / 1e6                    # initial normal stress, MPa
    ms = -mn * par.fric_rsf_r0                  # initial mean shear, MPa
    nstep = pu.step_of(fname)
    i = min(nstep, len(b)) - 1
    tdays = b[i, 0] / 86400.0
    vlin, vlog = peak_slip_rate(b, par)

    panels = [
        (v["shear_strike"] / 1e6, "shear stress (strike)", "MPa",
         "RdBu_r", ms - STRESS_R, ms + STRESS_R),
        (v["shear_dip"] / 1e6, "shear stress (dip)", "MPa",
         "RdBu_r", -STRESS_R, STRESS_R),
        (v["effective_normal"] / 1e6, "effective normal stress", "MPa",
         "RdBu_r", mn - STRESS_R, mn + STRESS_R),
        (np.log10(np.asarray(v["slip_rate"]) + 1e-30), "slip rate",
         "log10 V (m/s)", "magma", -14, 2),
        (v["state_normal"] / 1e6, "state (normal-regularised)", "MPa",
         "RdBu_r", -mn - STRESS_R, -mn + STRESS_R),
        (np.log10(np.maximum(np.asarray(v["state_variable"]), 1e-30)),
         "state variable", "log10 theta (s)", "viridis", 0, 10),
    ]

    # The six maps carry set_aspect("equal") -- a fault plane drawn to its real
    # proportions -- while the three time series do not, so in a plain grid the
    # rows do not line up. constrained_layout aligns them; the maps keep their
    # aspect and the series fill the row they share.
    fig, ax = plt.subplots(3, 3, figsize=(13, 9.5), constrained_layout=True)
    for k, (arr, title, unit, cmap, vmin, vmax) in enumerate(panels):
        a = ax[k // 3, k % 3]
        m = a.pcolormesh(x, z, arr, cmap=cmap, vmin=vmin, vmax=vmax,
                         shading="nearest")
        cb = plt.colorbar(m, ax=a, extend="both", fraction=0.046, pad=0.02)
        cb.set_label(unit, fontsize=11)
        cb.ax.tick_params(labelsize=10)
        a.set_title(title, fontsize=13)
        a.set_xlabel(xlab, fontsize=11)
        a.set_ylabel(ylab, fontsize=11)
        a.tick_params(labelsize=10)
        a.set_aspect("equal")

    for a, (xx, yy, xl, yl) in zip(
            ax[2], [(np.arange(1, len(b) + 1), vlin, "time step",
                     "peak slip rate (m/s)"),
                    (np.arange(1, len(b) + 1), vlog, "time step",
                     "log10 peak slip rate (m/s)"),
                    (b[:, 0] / 86400.0, vlog, "time (days)",
                     "log10 peak slip rate (m/s)")]):
        a.plot(xx, yy, lw=2.2, color="tab:blue")
        a.plot(xx[i], yy[i], "o", color="tab:red", ms=9,
               label="this snapshot")
        a.set_xlabel(xl, fontsize=11)
        a.set_ylabel(yl, fontsize=11)
        a.tick_params(labelsize=10)
        a.grid(alpha=0.25, lw=0.8)
        a.legend(fontsize=10, loc="best")

    case = getattr(par, "casename", "")
    flab = f" | fault {ift}/{nfault - 1}" if nfault > 1 else ""
    fig.suptitle(f"{case} | {os.path.basename(fname)} | step {nstep}"
                 f" | t = {tdays:.3f} d{flab}", fontsize=15)
    pu.save(fig, png, dpi=150)


def generate_gif(pngs, gif):
    try:
        import imageio
    except ImportError:
        print(f"skipping {gif}: python package 'imageio' is not installed "
              "(pip install imageio)")
        return
    with imageio.get_writer(gif, mode="I") as w:
        for p in pngs:
            w.append_data(imageio.v2.imread(p))
    print(f"wrote {gif} ({len(pngs)} frames)")


def process_dir(rdir, outdir):
    par = pu.load_par(rdir, "plotOnFaultVars")
    b = np.atleast_2d(read_array(os.path.join(rdir, "global.dat")))
    snaps = pu.sort_nicely([f for f in glob.glob(os.path.join(rdir, "fault.*.nc"))
                            if pu.step_of(f) is not None])
    with nc.Dataset(snaps[0]) as d:
        nfault = d.dimensions["nid_fault"].size if "nid_fault" in d.dimensions else 1

    for ift in range(nfault):
        sfx = f".f{ift}" if nfault > 1 else ""
        frames = []
        for f in snaps:
            png = pu.out_path(rdir, os.path.basename(f) + sfx + ".png", outdir)
            plot_fault_snapshot(f, ift, nfault, par, b, png)
            frames.append(png)
        generate_gif(frames, pu.out_path(rdir, f"on_fault_vars{sfx}.gif", outdir))


def main():
    ap = pu.make_parser(__doc__, "plotOnFaultVars",
                        "fault.NNNNN.nc[.fN].png and on_fault_vars[.fN].gif, "
                        "one per fault, into each cycle's directory.",
                        PATTERNS)
    args = ap.parse_args()
    for label, rdir in pu.resolve_targets(args.dirs, PATTERNS, "plotOnFaultVars"):
        print(f"processing {label or rdir} ({rdir})")
        process_dir(rdir, args.outdir)
    return 0


if __name__ == "__main__":
    sys.exit(main())
