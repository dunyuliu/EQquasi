#! /usr/bin/env python3
"""
Script to setup the case via user_defined_params.py.
"""
import os
import sys

# The case root holds only user_defined_params.py and this script; the modules
# they import (defaultParameters.py, lib.py) live under tool/, and the files
# this script writes go to input/ or log/. Keeping the root to two files makes
# "what did I change?" answerable at a glance.
_CASE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(_CASE, "tool"))
# Keep __pycache__ out of the case root: importing user_defined_params.py from
# the root would otherwise leave a directory there, and the root is meant to
# show two files.
sys.pycache_prefix = os.path.join(_CASE, "tool", "__pycache__")

from user_defined_params import par
from defaultParameters import (FR_RSF_A, FR_RSF_B, FR_RSF_DC, FR_RSF_V0,
    FR_RSF_F0, FR_VINIT, FR_TSTK0, FR_TNRM0, FR_STATE)
import netCDF4 as nc
import numpy as np

INPUT = "input"
LOG = "log"


def inp(name):
    """Path of a file a cycle consumes -- and only those.

    run.sh copies the whole of input/ into scratch/ before each cycle, and
    whatever is there ends up in result/cycleN. So input/ holds solver inputs
    and nothing else: the batch scripts are things you submit, not things a
    cycle reads, and they go in the case root with run.sh and case.submit."""
    os.makedirs(INPUT, exist_ok=True)
    return os.path.join(INPUT, name)

def create_model_input_file():
    # Function to create model.txt used by EQquasi.
    with open(inp('model.txt'), 'w') as f:
        f.write(str(par.fxmin) + "  " + str(par.fxmax) + "\n")
        f.write(str(par.fymin) + "  " + str(par.fymax) + "\n")
        f.write(str(par.fzmin) + "  " + str(par.fzmax) + "\n")
        f.write(str(par.xminc) + "  " + str(par.xmaxc) + "  " + str(par.zminc) + "\n")
        f.write(str(par.nuni_y_plus) + "  " + str(par.nuni_y_minus) + "\n")
        f.write(str(par.enlarging_ratio) + "\n")
        f.write(str(par.dx) + "\n")
        f.write(str(par.vp) + "  " + str(par.vs) + "  " + str(par.rou) + "\n")
        f.write(str(par.rough_fault) + "\n")
        f.write(str(par.rheology) + "\n")
        f.write(str(par.friclaw) + "\n")
        f.write(str(par.ntotft) + "\n")
        f.write(str(par.bp) + "\n")
        f.write(str(par.xi) + "  " + str(par.minDc) + "\n")
        f.write(str(par.exit_slip_rate) + "\n")
        f.write(str(par.far_vel_load) + "\n")
        f.write(str(par.far_norm_load_vel) + "\n")
        f.write(str(par.creep_slip_rate) + "\n")
        f.write(str(par.init_norm) + "\n")
        f.write(str(par.solver) + "\n")
        f.write(str(par.az_op) + "\n")
        f.write(str(par.az_maxiter) + "\n")
        f.write(str(par.az_tol) + "\n")
        f.write(str(par.nt_out) + "\n")
        f.write(str(par.mode) + "\n")
        f.write(str(par.nstep) + "\n")
        # Appended for bp8 (SEAS BP8, fluid injection in 3D). read_input.f90 reads
        # these with iostat, so appending here keeps older model.txt files loadable.
        f.write(str(par.fluid_src) + "\n")
        f.write(str(par.fluid_q0) + "  " + str(par.fluid_toff) + "  " + str(par.fluid_tend) + "\n")
        f.write(str(par.fluid_Lgauss) + "  " + str(par.fluid_Lfwid) + "\n")
        f.write(str(par.fluid_beta) + "  " + str(par.fluid_phi) + "  " + str(par.fluid_perm) + "  " + str(par.fluid_eta) + "\n")
        f.write(str(par.fluid_Swell) + "  " + str(par.fluid_rwell) + "\n")
        f.write(str(par.dtmax) + "\n")
        f.write(str(par.fric_pc_L) + "\n")
        # Effective normal stress caps. Appended to the scalar section, ahead of
        # the optional faultgeom block: read_input.f90 reads this with iostat,
        # so a model.txt written before this existed still loads and the solver
        # keeps its defaults. Cannot go after faultgeom -- 13 of 16 compset do
        # not write that block, and their faultgeom read would swallow this line.
        f.write(str(par.min_norm) + "  " + str(par.max_norm)
                + "  " + str(par.enforce_norm_caps) + "\n")
        # Optional per-fault geometry, one line per fault: xlo xhi ycoor zlo zhi (m).
        # read_input.f90 reads this block with iostat, so omitting it (the
        # attribute defaults to None) keeps every existing compset's
        # model.txt in the old single-domain-box format.
        if getattr(par, 'faultgeom', None) is not None:
            if len(par.faultgeom) != par.ntotft:
                raise ValueError(
                    f'par.faultgeom has {len(par.faultgeom)} entries but '
                    f'par.ntotft = {par.ntotft}; need exactly one per fault.')
            for xlo, xhi, ycoor, zlo, zhi in par.faultgeom:
                f.write(f"{xlo}  {xhi}  {ycoor}  {zlo}  {zhi}\n")

def create_station_input_file():
    # Function to create stations.txt used by EQquasi.
    # read_input.f90's readstations1/readstations2 already loop
    # ift = 1..ntotft (one nonfs count per fault, one coord block per fault
    # separated by a blank line). There is no per-fault station list yet, so
    # every fault is given the same st_coor_on_fault list; for ntotft == 1
    # this reduces to exactly the previous single-block format.
    with open(inp('stations.txt'), 'w') as f:
        f.write(str(par.n_off_fault) + "\n")
        f.write("  ".join([str(par.n_on_fault)] * par.ntotft) + "\n")
        for ift in range(par.ntotft):
            f.write(str(" ") + "\n")
            for i in range(len(par.st_coor_on_fault)):
                f.write(str(par.st_coor_on_fault[i][0]) + " " + str(par.st_coor_on_fault[i][1]) + "\n")
        f.write(str(" ") + "\n")
        for i in range(len(par.st_coor_off_fault)):
            f.write(str(par.st_coor_off_fault[i][0]) + " " + str(par.st_coor_off_fault[i][1]) + " " + str(par.st_coor_off_fault[i][2]) + "\n")

def netcdf_write_on_fault_vars():
  # Function to write on_fault_vars input used by EQquasi.
  #
  # par.on_fault_vars is either:
  #   - (nfz, nfx, 100): legacy single-fault layout. Written exactly as
  #     before -- dims (dip, strike), no fault dimension.
  #   - (ntotft, nfzMax, nfxMax, 100): multi-fault layout, padded to the
  #     largest fault's (nfxMax, nfzMax) extent, matching the convention
  #     netcdf_read_on_fault (src/netcdf_io.f90) expects: dims
  #     (fault, dip, strike), fault outermost (slowest-varying), so a
  #     fault's own (dip, strike) slab lands contiguously.
  # The layout is detected from array rank, never from par.ntotft, so the
  # reader and writer share one detection rule.
  ds = nc.Dataset(inp("on_fault_vars_input.nc"), "w", format="NETCDF4")
  ovars = par.on_fault_vars

  if ovars.ndim == 3:
    nfz, nfx = ovars.shape[0], ovars.shape[1]
    ds.createDimension('dip', nfz)
    ds.createDimension('strike', nfx)
    dims = ('dip', 'strike')
    dip_var = ds.createVariable('dip', np.float64, ('dip',))
    strike_var = ds.createVariable('strike', np.float64, ('strike',))
    dip_var[:] = par.fz[:]
    strike_var[:] = par.fx[:]
    slab = lambda icol: ovars[:, :, icol]
  elif ovars.ndim == 4:
    ntotft, nfzMax, nfxMax = ovars.shape[0], ovars.shape[1], ovars.shape[2]
    ds.createDimension('fault', ntotft)
    ds.createDimension('dip', nfzMax)
    ds.createDimension('strike', nfxMax)
    dims = ('fault', 'dip', 'strike')
    slab = lambda icol: ovars[:, :, :, icol]
  else:
    raise ValueError(
        f'par.on_fault_vars has unsupported rank {ovars.ndim}; expected 3 (single-fault) or 4 (multi-fault).')

  # Variable names are literal here (not built from a table) because
  # testsys/contract/test_io_contracts.py greps for createVariable('name', ...)
  # and compares the set against netcdf_io.f90's nf90_inq_varid('name') calls.
  var0 = ds.createVariable('a', np.float64, dims)
  var1 = ds.createVariable('b', np.float64, dims)
  var2 = ds.createVariable('Dc', np.float64, dims)
  var3 = ds.createVariable('v0', np.float64, dims)
  var4 = ds.createVariable('r0', np.float64, dims)
  var5 = ds.createVariable('init_slip_rate', np.float64, dims)
  var6 = ds.createVariable('init_shear_stress', np.float64, dims)
  var7 = ds.createVariable('init_normal_stress', np.float64, dims)
  var8 = ds.createVariable('init_state', np.float64, dims)
  var0.units = 'unit'
  var1.units = 'unit'
  var2.units = 'meters'
  var3.units = 'm/s'
  var4.units = 'unit'
  var5.units = 'm/s'
  var6.units = 'Pa'
  var7.units = 'Pa'
  var8.units = 'unit'
  var0[...] = slab(FR_RSF_A)
  var1[...] = slab(FR_RSF_B)
  var2[...] = slab(FR_RSF_DC)
  var3[...] = slab(FR_RSF_V0)
  var4[...] = slab(FR_RSF_F0)
  var5[...] = slab(FR_VINIT)
  var6[...] = slab(FR_TSTK0)
  var7[...] = slab(FR_TNRM0)
  var8[...] = slab(FR_STATE)
  ds.close()
  
def create_batch_script():
    # Function to create batch script used by HPC system.
    with open("batch.hpc", "w") as f:
        f.write("#! /bin/bash" + "\n")
        f.write("#SBATCH -J " + str(par.casename) + "\n")
        f.write("#SBATCH -o a.eqquasi.log%j" + "\n")
        f.write("#SBATCH -N " + str(par.HPC_nnode) + "\n")
        f.write("#SBATCH -n " + str(par.HPC_ncpu) + "\n")
        f.write("#SBATCH -p " + str(par.HPC_queue) + "\n")
        f.write("#SBATCH -t " + str(par.HPC_time) + "\n")
        f.write("#SBATCH -A " + str(par.HPC_account) + "\n")
        f.write("#SBATCH --mail-user=" + str(par.HPC_email) + "\n")
        f.write("#SBATCH --mail-type=begin" + "\n")
        f.write("#SBATCH --mail-type=end" + "\n")
        f.write("export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}" + "\n")
        f.write("  module load mumps"     + "\n")
        # Executable part.
        f.write("for i in $(seq " + str(par.istart) + " " + str(par.iend) + ");" + "\n")
        f.write("do" + "\n")
        # Same scratch workflow as run.sh: the solver writes where it is, so
        # run it inside tmp/ and package from there. A batch job that dies
        # part-way otherwise strews half-written output across the case root,
        # where the inputs live.
        f.write("  rm -rf tmp && mkdir tmp" + "\n")
        f.write("  for g in model.txt stations.txt on_fault_vars_input.nc \\" + "\n")
        f.write("           bFault_Rough_Geometry.txt roughness.nc *.r.nc; do" + "\n")
        f.write("    [ -e \"$g\" ] && cp \"$g\" tmp/" + "\n")
        f.write("  done" + "\n")
        f.write("  echo $i > tmp/currentcycle.txt" + "\n")
        f.write("  (cd tmp && ibrun " + _exe_name() + ")" + "\n")
        f.write("  mkdir -p \"./cycle$((i-1))\"" + "\n")
        # Everything the cycle produced is in tmp/, so move the lot: no
        # pattern list to keep in step with what the solver writes, which is
        # how the BP8 section 4.3 profiles and runInfo.json were stranded in
        # the case root before.
        f.write("  mv tmp/* \"./cycle$((i-1))/\"" + "\n")
        f.write("  rm -rf tmp" + "\n")
        f.write("  cp \"./cycle$((i-1))/\"*.r.nc ./" + "\n")
        # Post-processing tools live on PATH (source install.eqquasi.sh), not
        # in the case directory; they take the cycle directory as an argument.
        f.write("  plotOnFaultVars \"./cycle$((i-1))\" || echo 'plotOnFaultVars "
                "not on PATH; source install.eqquasi.sh and rerun by hand'"
                + "\n")
        f.write("done" + "\n")
        # End excutable part.

def _exe_name():
    """`eqquasi-<version>`, read from the source the run will be built from.

    Fails loudly rather than falling back to a bare `eqquasi`: a run.sh that
    names no version is exactly what let a rebuild be picked up mid-run.
    """
    import re
    root = os.environ.get("EQQUASIROOT")
    if not root:
        raise SystemExit("case.setup: EQQUASIROOT is not set, so the EQquasi "
                         "version cannot be read; source install.eqquasi.sh.")
    gv = os.path.join(root, "src", "globalvar.f90")
    try:
        m = re.search(r"EQQUASI_VERSION\s*=\s*'([^']+)'", open(gv).read())
    except OSError as exc:
        raise SystemExit(f"case.setup: cannot read {gv} ({exc}).")
    if not m:
        raise SystemExit(f"case.setup: no EQQUASI_VERSION in {gv}.")
    return "eqquasi-" + m.group(1)


def create_run_sh():
    """Write run.sh into the case root: the one thing a user runs.

    Each cycle runs inside scratch/ and is packaged into result/cycleN/ only
    after it succeeds. The solver takes no output path -- it writes to its
    working directory -- so `cd scratch` is what redirects it.

    Failure leaves scratch/ untouched and creates no result/cycleN, so a
    half-written cycle can never be mistaken for a finished one. Recovery is
    `rm -rf scratch`; a full reset is `rm -rf scratch result`.
    """
    with open("run.sh", "w") as f:
        w = lambda t: f.write(t + "\n")
        # Pin OpenMP threads. Left unset, each MPI rank spawns as many threads
        # as it likes and several ranks oversubscribe a node badly; measured
        # scaling is only 1.24x for 8 ranks, so threads buy nothing here.
        w("export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}")
        w("mkdir -p result log")
        w("for i in $(seq " + str(par.istart) + " " + str(par.iend) + ");")
        w("do")
        w("  rm -rf scratch && mkdir scratch")
        # No copying. The solver reads input/ and writes scratch/ directly --
        # one copy of every input, whatever its size, and nothing of the
        # layout duplicated per cycle. It runs at the case root, and stops
        # with stop 6 if either directory is missing rather than falling back
        # to the current directory.
        w("  echo $i > scratch/currentcycle.txt")
        # The restart pair is per-cycle state, not a case input: it comes from
        # the cycle just finished. Staged into scratch/ so the solver reads it
        # where it reads currentcycle.txt, and so input/ stays exactly what
        # case.setup wrote -- frozen once the case has run.
        w('  prev="result/cycle$((i-2))"')
        w('  if [ -d "$prev" ]; then')
        w('    for g in "$prev"/*.r.nc; do [ -e "$g" ] && cp "$g" scratch/; done')
        w("  fi")
        # Name the binary by version. bin/ holds eqquasi-<version> and
        # deliberately no plain `eqquasi`, so a case records which build
        # produced it and a rebuild cannot be picked up mid-run by a loop
        # that relaunches each cycle.
        w("  mpirun.openmpi -np " + str(par.HPC_ncpu) + " " + _exe_name())
        w("  status=$?")
        w("  if [ $status -ne 0 ]; then")
        w('    echo "eqquasi exited $status in cycle $((i-1)); output left in '
          'scratch/ for inspection; it is deleted when you retry." >&2')
        w("    exit $status")
        w("  fi")
        w('  mkdir -p "result/cycle$((i-1))"')
        w('  mv scratch/* "result/cycle$((i-1))/"')
        w("  rm -rf scratch")
        # Nothing to copy back: the next cycle fetches the restart pair from
        # result/cycle$((i-1)) directly, so there is one copy of it and input/
        # is never written to after case.setup.
        w("done")


def create_batch_script_cycle():
    # Function to create batch script - batch.cycle.hpc - for cycle simulations used by HPC system.
    # Compared to batch.hpc, we don't do cycle id looping here. 
    with open("batch.cycle.eqquasi.hpc", "w") as f:
        f.write("#! /bin/bash"                      + "\n")
        f.write("#SBATCH -J " + str(par.casename)       + "\n")
        f.write("#SBATCH -o a.eqquasi.log%j"        + "\n")
        f.write("#SBATCH -N " + str(par.HPC_nnode)      + "\n")
        f.write("#SBATCH -n " + str(par.HPC_ncpu)       + "\n")
        f.write("#SBATCH -p " + str(par.HPC_queue)      + "\n")
        f.write("#SBATCH -t " + str(par.HPC_time)       + "\n")
        f.write("#SBATCH -A " + str(par.HPC_account)    + "\n")
        f.write("#SBATCH --mail-user=" + str(par.HPC_email) + "\n")
        f.write("#SBATCH --mail-type=begin"         + "\n")
        f.write("#SBATCH --mail-type=end"           + "\n")
        # Executable part.
        f.write("export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}" + "\n")
        f.write("  module load mumps"               + "\n")
        f.write("  read i < currentcycle.txt"       + "\n")
        f.write("# fetch input files from /eqquasi" + "\n")
        f.write("  cp eqquasi/model.txt ./"         + "\n")
        f.write("  cp eqquasi/stations.txt ./"      + "\n")
        f.write("  cp eqquasi/rough_geo_cycle.txt ./"      + "\n")
        f.write("  cp eqquasi/on_fault_vars_input.nc ./" + "\n")
        f.write("# if cycle id>1, then fetch fault.dyna.r.nc from D(i-2)" + "\n")
        f.write("  if ((i > 1))"                    + "\n")
        f.write("  then"                            + "\n")
        f.write("    echo 'Simulating cycle ' $i '... ...'"  + "\n")
        f.write("    cp -r \"D$((i-2))/\"fault.dyna.r.nc ./" + "\n")
        f.write("    cp -r fault.dyna.r.nc fault.r.nc"       + "\n")
        f.write("  fi"                                       + "\n")
        f.write("# run eqquasi"                     + "\n")
        f.write("  ibrun " + _exe_name()            + "\n")
        f.write("# move results to Q(i-1)"          + "\n")
        f.write("# delete Q(i-1)"                   + "\n")
        f.write("  rm -rf \"cycle$((i-1))\""            + "\n")
        f.write("# create Q(i-1) and copy results and inputs over" + "\n")
        f.write("  mkdir \"cycle$((i-1))\""             + "\n")
        f.write("  cp -r a.eqquasi.log* \"cycle$((i-1))\""         + "\n")
        f.write("  cp -r on_fault_vars_input.nc \"cycle$((i-1))\"" + "\n")
        f.write("  cp -r currentcycle.txt \"cycle$((i-1))\""       + "\n")
        f.write("  for f in fltst* srfst* tdyna* *_strike.dat *_depth.dat runInfo.json; do" + "\n")
        f.write("    [ -e \"$f\" ] && cp -r \"$f\" \"cycle$((i-1))\"" + "\n")
        f.write("  done" + "\n")
        f.write("  cp -r global* p1* p2* disp.* \"cycle$((i-1))\"" + "\n")
        f.write("  cp -r rough* \"cycle$((i-1))\"" + "\n")
        f.write("  cp -r fault.* cplot* \"cycle$((i-1))\""         + "\n")
        f.write("  cp -r eqquasi/plot_on_fault_vars2 \"cycle$((i-1))\"" + "\n")
        f.write("  cp -r eqquasi/user_defined_params.py \"cycle$((i-1))\"" + "\n")
        f.write("  cp -r eqquasi/lib.py \"cycle$((i-1))\""                 + "\n")
        f.write("# clean up the root for running eqdyna"               + "\n")
        f.write("  rm -rf a.eqquasi.log* model.txt stations.txt"       + "\n")
        f.write("  rm -rf on_fault_vars_input.nc"                      + "\n")
        f.write("  rm -rf fltst* srfst* tdyna* global* p1* p2* disp.*" + "\n")
        f.write("  rm -rf fault.* cplot* "                             + "\n")
        f.write("  rm -rf eqquasi.mesh.*"                              + "\n")
        f.write("# postprocessing"                                     + "\n")
        f.write("  cd \"cycle$((i-1))\""                                   + "\n")
        f.write("  ibrun -np 1 python plot_on_fault_vars2"             + "\n")
        f.write("  cd .."                                              + "\n")
        # End excutable part.

def estimate_HPC_resource():
    nx = round((par.fxmax-par.fxmin)/par.dx)
    nz = round((par.fzmax-par.fzmin)/par.dz)
    ncell = nx*nz*(par.nuni_y_plus + par.nuni_y_minus)*2
    estimate_ncpu = int(ncell/10000)
    estimate_nnode = int(estimate_ncpu/128) + 1
    print("Estimated total cells in the model is " + str(ncell))
    print("Estimated number of computing nodes to be requested is " + str(estimate_nnode))
    print("Estimated number of CPUs to be requested is " + str(estimate_ncpu))

# Below this the adaptive time step goes into a limit cycle rather than
# resolving a rupture. Calibrated against runs, not taken from a paper: BP5 at
# dx = 2000 m sits at 1.32 and behaves; the kink case at dx = 1200 m sits at
# 0.47 and its slip rate oscillates between 1e-1 and 1e-6 for thousands of
# steps inside what should be one event.
COHESIVE_ZONE_MIN = 1.0


def report_cohesive_zone():
    """Cohesive-zone width against cell size, printed before the run.

    Lambda_0 = C1 * mu* * Dc / (b * sigma_n) is the width of the zone behind
    the rupture front over which strength drops. If a cell is wider than it,
    no mesh point sits inside the front and the solution is set by the
    discretization rather than the friction law.

    This is the cheapest possible check -- five parameters and no run -- for a
    failure that otherwise costs hours and looks like physics: a fault that
    "ruptures" repeatedly, normal stress that never evolves, and cycles that
    end after a day.

    Reported, not enforced. The test.* compset are deliberately coarse, and a
    convergence study needs to run the under-resolved cases on purpose. What
    it must never do is let one pass unremarked.
    """
    need = ("fric_rsf_Dc", "fric_rsf_b", "init_norm", "vs", "rou", "dx")
    missing = [n for n in need if getattr(par, n, None) in (None, 0)]
    if missing:
        print(f"  cohesive zone: not computed, {', '.join(missing)} unset")
        return

    mu_star = par.rou * par.vs ** 2          # shear modulus, Pa
    c1 = 9.0 * 3.141592653589793 / 32.0      # Lapusta & Liu (2009), mode III
    lam = c1 * mu_star * par.fric_rsf_Dc / (par.fric_rsf_b * abs(par.init_norm))
    ratio = lam / par.dx

    print(f"  cohesive zone Lambda_0 = {lam:.0f} m, dx = {par.dx:.0f} m, "
          f"Lambda_0/dx = {ratio:.2f}")
    if ratio < COHESIVE_ZONE_MIN:
        print("  " + "!" * 68)
        print(f"  ! UNDER-RESOLVED: Lambda_0/dx = {ratio:.2f} < "
              f"{COHESIVE_ZONE_MIN}. For reference BP5 runs at 1.32.")
        print(f"  ! At {ratio:.2f} the adaptive time step (dt ~ ksi*Dc/V) can")
        print( "  ! enter a limit cycle: V falls, dt grows, the larger step")
        print( "  ! overshoots, V climbs, and the pair oscillate instead of")
        print( "  ! resolving one rupture. The output still looks like events.")
        print(f"  ! dx <= {lam / COHESIVE_ZONE_MIN:.0f} m would clear it, or a")
        print( "  ! larger Dc. Proceeding -- this is a warning, not a gate.")
        print("  " + "!" * 68)


def refuse_if_case_has_run():
    """Refuse to regenerate input/ once the case has produced anything.

    case.setup rewrites model.txt, stations.txt and on_fault_vars_input.nc
    from user_defined_params.py. Doing that between cycles of a multi-cycle
    run would silently hand later cycles different inputs from earlier ones,
    and nothing downstream would show the two halves were not comparable.

    So setup is a one-way door: once result/ holds a cycle, or scratch/ holds
    a cycle in progress, the inputs are frozen. Changing parameters means a new
    case, which is cheap. Pass --force to override, for the case where you know
    the regenerated inputs are identical (fixing a typo in a comment, say).
    """
    import sys as _sys
    if "--force" in _sys.argv:
        return
    done = sorted(d for d in os.listdir("result")) if os.path.isdir("result") else []
    running = os.path.isdir("scratch") and os.listdir("scratch")
    if not done and not running:
        return
    what = (f"result/ holds {', '.join(done[:4])}"
            + (" ..." if len(done) > 4 else "")) if done else "scratch/ is not empty"
    raise SystemExit(
        "case.setup: this case has already run -- " + what + ".\n"
        "Regenerating input/ now would give later cycles different inputs "
        "from the ones already used, and each result/cycleN keeps the inputs "
        "that produced it, so the halves would not be comparable.\n"
        "Start a new case for changed parameters, or pass --force if you are "
        "certain the regenerated inputs are identical.")


def _main_func(description):
  refuse_if_case_has_run()
  create_model_input_file()
  create_batch_script()
  create_batch_script_cycle()
  create_run_sh()
  create_station_input_file()
  estimate_HPC_resource()
  report_cohesive_zone()
  netcdf_write_on_fault_vars()
  if par.insertFaultType>0:
      # Check the exit status. This used to be ignored, so when
      # generateFaultInterface failed -- e.g. matplotlib missing from the
      # active interpreter -- case.setup reported success, the case looked
      # complete, and the run silently produced no output at all.
      # The tool lives in script/ (on PATH once install.eqquasi.sh is
      # sourced); older cases may still carry a copy beside case.setup.
      gfi = ('./generateFaultInterface'
             if os.path.exists('./generateFaultInterface')
             else 'generateFaultInterface')
      rc = os.system(gfi + ' .')
      if os.waitstatus_to_exitcode(rc) != 0:
          raise SystemExit(
              'case.setup: generateFaultInterface failed (exit '
              f'{os.waitstatus_to_exitcode(rc)}). par.insertFaultType='
              f'{par.insertFaultType} requires it to produce the fault '
              'interface; without it the simulation has no geometry to run.')

if __name__ == "__main__":
    _main_func(__doc__)
