#! /usr/bin/env python3
"""Map the on-fault initial conditions a case will run with.

Reads par.on_fault_vars from the case's user_defined_params.py -- the array
case.setup writes into on_fault_vars_input.nc -- and maps the RSF parameters
(a, b, Dc), the initial slip rate, and the initial normal and shear stresses
over the fault plane. Useful as a pre-run sanity check that the friction
zonation and nucleation patch are where you intended.

This is a case-level tool: it needs only user_defined_params.py, no run
output, so there is no cycle discovery. Point it at the case directory
(default: the current one).

Reads:  user_defined_params.py
Writes: Initials.png into the case directory
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import plotutils as pu

pu.apply_style()
import matplotlib.pyplot as plt
import numpy as np

# (slice index in on_fault_vars, title, unit, scale)
PANELS = [
    (9, "RSF a", "-", 1.0),
    (10, "RSF b", "-", 1.0),
    (11, "RSF Dc", "m", 1.0),
    (46, "initial slip rate", "m/s", 1.0),
    (7, "initial normal stress", "MPa", 1e6),
    (8, "initial shear stress", "MPa", 1e6),
]


def main():
    ap = argparse.ArgumentParser(
        prog="plotOnFaultInitals", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="usage from a case folder: plotOnFaultInitals\n"
               "from anywhere:            plotOnFaultInitals <case>")
    ap.add_argument("case_dir", nargs="?", default=".",
                    help="case directory holding user_defined_params.py "
                         "(default: current directory)")
    ap.add_argument("-o", "--outdir", default=None, metavar="DIR",
                    help="write Initials.png here instead of into the case")
    args = ap.parse_args()

    par = pu.load_par(args.case_dir, "plotOnFaultInitals")
    v = np.asarray(getattr(par, "on_fault_vars", None))
    # Compsets now always carry the leading fault axis -- (ntotft, nfz, nfx,
    # nvar) -- with ntotft = 1 the degenerate case, matching what case.setup
    # writes. Rejecting anything but rank 3 refused every multi-fault case,
    # exactly the ones whose initial conditions are worth looking at.
    if v.ndim == 3:
        v = v[None, ...]
    if v.ndim != 4:
        pu.die(f"plotOnFaultInitals: par.on_fault_vars in {args.case_dir} is "
               f"not the expected (ntotft, nfz, nfx, nvar) array (got shape "
               f"{None if v is None else v.shape})")
    nfault = v.shape[0]

    if args.outdir:
        os.makedirs(args.outdir, exist_ok=True)
    for ift in range(nfault):
        ndip, nstrike = v.shape[1:3]
        x, z, xlab, ylab = pu.fault_coords(par, ndip, nstrike, ift)
        fig, ax = plt.subplots(2, 3, figsize=(12, 7))
        for k, (idx, title, unit, scale) in enumerate(PANELS):
            a = ax[k // 3, k % 3]
            vals = v[ift, :, :, idx] / scale
            # A uniform field gives vmin == vmax, which normalises to nothing:
            # matplotlib then colours it arbitrarily, so two faults holding the
            # same constant can come out different colours. Widen the range so
            # a constant reads as a constant.
            vmin, vmax = float(np.min(vals)), float(np.max(vals))
            if vmin == vmax:
                pad = abs(vmin) * 0.01 or 1.0
                vmin, vmax = vmin - pad, vmax + pad
            m = a.pcolormesh(x, z, vals, cmap="viridis", vmin=vmin, vmax=vmax,
                             shading="nearest")
            cb = plt.colorbar(m, ax=a)
            cb.set_label(unit)
            a.set_title(title)
            a.set_xlabel(xlab)
            a.set_ylabel(ylab)
            a.set_aspect("equal")
        flab = f" | fault {ift}/{nfault - 1}" if nfault > 1 else ""
        fig.suptitle(f"On-fault initial conditions — "
                     f"{getattr(par, 'casename', os.path.abspath(args.case_dir))}"
                     f"{flab}")
        fig.tight_layout()
        sfx = f".f{ift}" if nfault > 1 else ""
        out = os.path.join(args.outdir or args.case_dir, f"Initials{sfx}.png")
        pu.save(fig, out, dpi=150)
    return 0


if __name__ == "__main__":
    sys.exit(main())
