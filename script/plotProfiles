#! /usr/bin/env python3
"""Temporal evolution of on-fault variables along two fixed profiles.

For each cycle, reads every fault.NNNNN.nc snapshot and draws the variable
along (mode 1) the vertical profile at mid-strike and (mode 2) the horizontal
profile at 3/4 of the model depth, one line per sampled snapshot, for each of:
effective_normal, slip_rate, shear_strike, slips. Lines are boxcar-smoothed
over --nwindow nodes and only every --ninterval-th snapshot is drawn.

Multi-fault runs: --fault selects the fault (default 0); the fault index is
appended to the file name and title.

Reads:  fault.NNNNN.nc per cycle
Writes: cVerticalProfile.<var>[.fN].png and cHorizontalProfile.<var>[.fN].png
        into each cycle's directory
"""

import glob
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import plotutils as pu
from lib import boxcar_average

pu.apply_style()
import matplotlib.pyplot as plt
import numpy as np
import netCDF4 as nc

PATTERNS = ["fault.[0-9]*.nc"]

VARS = {
    "effective_normal": (1e6, "stress (MPa)"),
    "slip_rate": (1.0, "slip rate (m/s)"),
    "shear_strike": (1e6, "stress (MPa)"),
    "slips": (1.0, "slip along strike (m)"),
}


def profile_series(rdir, mode, var, ninterval, nwindow, ifault):
    """(nodes, series) array of smoothed profiles, one column per snapshot."""
    snaps = pu.sort_nicely(
        [f for f in glob.glob(os.path.join(rdir, "fault.*.nc"))
         if pu.step_of(f) is not None])[::ninterval]
    cols = []
    for f in snaps:
        with nc.Dataset(f) as d:
            v = np.asarray(pu.fault_slab(d.variables[var][:], ifault, var, f),
                           float)
        nrow, ncol = v.shape
        if mode == 1:
            line = v[:, ncol // 2]
        else:
            line = v[(nrow // 4) * 3, :]     # 3/4 of the way down the grid
        cols.append(boxcar_average(line, min(nwindow, len(line))))
    return np.array(cols).T


def process_dir(rdir, outdir, ninterval, nwindow, ifault, nfault):
    sfx = f".f{ifault}" if nfault > 1 else ""
    for var, (scale, ylabel) in VARS.items():
        for mode, orient, xlabel in ((1, "Vertical", "node # down dip"),
                                     (2, "Horizontal", "node # along strike")):
            data = profile_series(rdir, mode, var, ninterval, nwindow, ifault)
            fig, ax = plt.subplots(figsize=(8, 6))
            for i in range(data.shape[1]):
                ax.plot(data[:, i] / scale, lw=0.9)
            ax.set_xlabel(xlabel)
            ax.set_ylabel(ylabel)
            ax.set_title(f"{orient} profile — {var} — "
                         f"{os.path.basename(os.path.abspath(rdir))}"
                         + (f" — fault {ifault}" if nfault > 1 else "")
                         + f" ({data.shape[1]} snapshots)")
            ax.grid(alpha=0.3)
            fig.tight_layout()
            pu.save(fig, pu.out_path(rdir, f"c{orient}Profile.{var}{sfx}.png",
                                     outdir), dpi=150)


def main():
    ap = pu.make_parser(__doc__, "plotProfiles",
                        "c{Vertical,Horizontal}Profile.<var>[.fN].png into "
                        "each cycle's directory.", PATTERNS)
    ap.add_argument("--fault", type=int, default=None,
                    help="fault index for multi-fault runs "
                         "(default: all faults)")
    ap.add_argument("--ninterval", type=int, default=1,
                    help="draw every Nth snapshot (default 1: all)")
    ap.add_argument("--nwindow", type=int, default=10,
                    help="boxcar smoothing window in nodes (default 10)")
    args = ap.parse_args()

    for label, rdir in pu.resolve_targets(args.dirs, PATTERNS, "plotProfiles"):
        print(f"processing {label or rdir} ({rdir})")
        first = min((f for f in glob.glob(os.path.join(rdir, "fault.*.nc"))
                     if pu.step_of(f) is not None), key=pu.step_of)
        with nc.Dataset(first) as d:
            nfault = (d.dimensions["nid_fault"].size
                      if "nid_fault" in d.dimensions else 1)
        faults = range(nfault) if args.fault is None else [args.fault]
        for ift in faults:
            process_dir(rdir, args.outdir, args.ninterval, args.nwindow,
                        ift, nfault)
    return 0


if __name__ == "__main__":
    sys.exit(main())
