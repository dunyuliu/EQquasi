#! /usr/bin/env python3
"""Correlate end-of-cycle effective normal stress with fault roughness.

For rough-fault cases only: reads the final stress state (fault.r.nc) and the
fault geometry (roughness.nc, in the results directory or the case root) and
overlays, along a vertical (mid-strike) and a horizontal (40 nodes below the
surface) profile: effective normal stress, the roughness, and its gradient --
printing the correlation coefficients between stress and each. High
correlation between normal-stress perturbation and roughness gradient is the
expected signature of a rough fault loaded in shear.

Profiles are boxcar-smoothed over --nwindow nodes. Multi-fault runs: --fault
selects the fault (default 0).

Reads:  fault.r.nc, roughness.nc
Writes: c{Vertical,Horizontal}ProfileStressRoughness.png per cycle
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import plotutils as pu
from lib import boxcar_average

pu.apply_style()
import matplotlib.pyplot as plt
import numpy as np
import netCDF4 as nc

PATTERNS = ["fault.r.nc"]
DEPTH_ROWS = 40   # horizontal profile: this many nodes below the surface


def profile(arr2d, mode, nwindow):
    nrow, ncol = arr2d.shape
    if mode == 1:
        line = arr2d[:, ncol // 2]
    else:
        line = arr2d[max(0, nrow - 1 - DEPTH_ROWS), :]
    return boxcar_average(line, min(nwindow, len(line)))


def process_dir(rdir, outdir, nwindow, ifault):
    rough_path = None
    for cand in (os.path.join(rdir, "roughness.nc"),
                 os.path.join(os.path.dirname(os.path.abspath(rdir)),
                              "roughness.nc")):
        if os.path.exists(cand):
            rough_path = cand
            break
    if rough_path is None:
        pu.die(f"plotCompareStressRoughness: no roughness.nc in {rdir} or its "
               "parent -- this tool is for rough-fault cases "
               "(par.insertFaultType = 2).")

    with nc.Dataset(os.path.join(rdir, "fault.r.nc")) as d:
        sigma = np.asarray(pu.fault_slab(d.variables["effective_normal"][:],
                                         ifault, "effective_normal",
                                         "fault.r.nc"), float) / 1e6
    with nc.Dataset(rough_path) as d:
        peak = np.asarray(pu.fault_slab(d.variables["peak"][:], ifault,
                                        "peak", rough_path), float)

    for mode, orient, xlabel in ((1, "Vertical", "node # down dip"),
                                 (2, "Horizontal", "node # along strike")):
        d1 = profile(sigma, mode, nwindow)
        d2 = profile(peak, mode, nwindow)
        g2 = np.gradient(d2)

        # The stress and roughness grids may differ by a margin; centre or
        # bottom-align the shorter roughness profile on the stress profile.
        res2, res3 = np.zeros(len(d1)), np.zeros(len(d1))
        off = (len(d1) - len(d2)) if mode == 1 else (len(d1) - len(d2)) // 2
        off = max(0, off)
        res2[off:off + len(g2)] = g2[:len(res2) - off]
        res3[off:off + len(d2)] = d2[:len(res3) - off]

        c_grad = np.corrcoef(d1, res2)[0][1]
        c_self = np.corrcoef(d1, res3)[0][1]
        print(f"  {orient.lower()}: corr(sigma_eff, roughness gradient) = "
              f"{c_grad:.2f}, corr(sigma_eff, roughness) = {c_self:.2f}")

        fig, ax1 = plt.subplots(figsize=(10, 5))
        ax2 = ax1.twinx()
        ax3 = ax1.twinx()
        ax3.spines.right.set_position(("axes", 1.12))
        l1, = ax1.plot(d1, color="g", lw=1.4, label="effective normal stress")
        l2, = ax2.plot(res2, color="r", lw=1.0, label="roughness gradient")
        l3, = ax3.plot(res3, color="b", lw=1.0, label="roughness")
        ax1.set_xlabel(xlabel)
        ax1.set_ylabel("effective normal stress (MPa)", color="g")
        ax2.set_ylabel("roughness gradient (-)", color="r")
        ax3.set_ylabel("roughness (m)", color="b")
        ax1.set_title(f"{orient} profile — stress vs roughness — "
                      f"{os.path.basename(os.path.abspath(rdir))}\n"
                      f"corr(grad) = {c_grad:.2f}, corr(self) = {c_self:.2f}, "
                      f"smoothing window {nwindow} nodes")
        ax1.legend(handles=[l1, l2, l3], loc="lower right")
        fig.tight_layout()
        pu.save(fig, pu.out_path(rdir,
                                 f"c{orient}ProfileStressRoughness.png",
                                 outdir), dpi=150)


def main():
    ap = pu.make_parser(__doc__, "plotCompareStressRoughness",
                        "c{Vertical,Horizontal}ProfileStressRoughness.png "
                        "into each cycle's directory.", PATTERNS)
    ap.add_argument("--fault", type=int, default=0,
                    help="fault index for multi-fault runs (default 0)")
    ap.add_argument("--nwindow", type=int, default=10,
                    help="boxcar smoothing window in nodes (default 10)")
    args = ap.parse_args()
    for label, rdir in pu.resolve_targets(args.dirs, PATTERNS,
                                          "plotCompareStressRoughness"):
        print(f"processing {label or rdir} ({rdir})")
        process_dir(rdir, args.outdir, args.nwindow, args.fault)
    return 0


if __name__ == "__main__":
    sys.exit(main())
